{{#if site.keys.aiSearchId}}
  <!-- Kapa snippet -->
  <!--
    This script is a config placeholder. The actual widget is loaded using this config based on consent state.
  -->
  <script
    type="text/plain"
    id="kapa-widget-config"
    src="https://widget.kapa.ai/kapa-widget.bundle.js"
    data-button-hide="true"
    data-mcp-enabled="true"
